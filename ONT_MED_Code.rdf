<?xml version="1.0"?>
<rdf:RDF xmlns="http://purl.org/lahouaziamine/ontMed/"
     xml:base="http://purl.org/lahouaziamine/ontMed/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:dcterms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="http://purl.org/lahouaziamine/ontMed">
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-11-10</dcterms:created>
        <dcterms:creator>LAHOUAZI Amine</dcterms:creator>
        <dcterms:description xml:lang="fr">Ontologie de médecine générale (patients, professionnels de santé, pathologies) construite selon la méthodologie METHONTOLOGY.</dcterms:description>
        <dcterms:title xml:lang="fr">Ontologie Médicale</dcterms:title>
        <rdfs:comment xml:lang="fr">Ontologie conçu pour le domaine médical</rdfs:comment>
        <rdfs:label xml:lang="fr">Ontologie Médicale</rdfs:label>
        <owl:versionInfo>1.0</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/dc/terms/created -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/created"/>
    


    <!-- http://purl.org/dc/terms/creator -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/creator"/>
    


    <!-- http://purl.org/dc/terms/description -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>
    


    <!-- http://purl.org/dc/terms/title -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#altLabel -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#altLabel"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#broadMatch -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#broadMatch"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#exactMatch -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#exactMatch"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/2001/XMLSchema#date -->

    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/lahouaziamine/ontMed/consulte -->

    <owl:ObjectProperty rdf:about="http://purl.org/lahouaziamine/ontMed/consulte">
        <owl:inverseOf rdf:resource="http://purl.org/lahouaziamine/ontMed/estConsultePar"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://purl.org/lahouaziamine/ontMed/Patient"/>
        <rdfs:range rdf:resource="http://purl.org/lahouaziamine/ontMed/MedecinGeneraliste"/>
        <rdfs:comment xml:lang="fr">Le patient se rend en consultation auprès du médecin.</rdfs:comment>
        <rdfs:label xml:lang="fr">consulte</rdfs:label>
        <skos:altLabel xml:lang="fr">Est reçu par</skos:altLabel>
        <skos:altLabel xml:lang="fr">Rend visite à</skos:altLabel>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/lahouaziamine/ontMed/estConsultePar -->

    <owl:ObjectProperty rdf:about="http://purl.org/lahouaziamine/ontMed/estConsultePar">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://purl.org/lahouaziamine/ontMed/MedecinGeneraliste"/>
        <rdfs:range rdf:resource="http://purl.org/lahouaziamine/ontMed/Patient"/>
        <rdfs:label xml:lang="fr">est consulté par</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/lahouaziamine/ontMed/estDiagnostique -->

    <owl:ObjectProperty rdf:about="http://purl.org/lahouaziamine/ontMed/estDiagnostique">
        <owl:inverseOf rdf:resource="http://purl.org/lahouaziamine/ontMed/estDiagnostiqueeChez"/>
        <rdfs:domain rdf:resource="http://purl.org/lahouaziamine/ontMed/Patient"/>
        <rdfs:range rdf:resource="http://purl.org/lahouaziamine/ontMed/Pathologie"/>
        <rdfs:comment xml:lang="fr">Le médecin conclut que le patient est atteint de cette pathologie.</rdfs:comment>
        <rdfs:label xml:lang="fr">est diagnostiqué</rdfs:label>
        <skos:altLabel xml:lang="fr">A pour diagnostic</skos:altLabel>
        <skos:altLabel xml:lang="fr">Est atteint de</skos:altLabel>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/lahouaziamine/ontMed/estDiagnostiqueeChez -->

    <owl:ObjectProperty rdf:about="http://purl.org/lahouaziamine/ontMed/estDiagnostiqueeChez">
        <rdfs:domain rdf:resource="http://purl.org/lahouaziamine/ontMed/Pathologie"/>
        <rdfs:range rdf:resource="http://purl.org/lahouaziamine/ontMed/Patient"/>
        <rdfs:label xml:lang="fr">est diagnostiquée chez</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/lahouaziamine/ontMed/estSuiviPar -->

    <owl:ObjectProperty rdf:about="http://purl.org/lahouaziamine/ontMed/estSuiviPar">
        <owl:inverseOf rdf:resource="http://purl.org/lahouaziamine/ontMed/suit"/>
        <rdfs:domain rdf:resource="http://purl.org/lahouaziamine/ontMed/Patient"/>
        <rdfs:range rdf:resource="http://purl.org/lahouaziamine/ontMed/MedecinGeneraliste"/>
        <rdfs:label xml:lang="fr">est suivi par</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/lahouaziamine/ontMed/orienteVers -->

    <owl:ObjectProperty rdf:about="http://purl.org/lahouaziamine/ontMed/orienteVers">
        <owl:inverseOf rdf:resource="http://purl.org/lahouaziamine/ontMed/recoitOrientationDe"/>
        <rdfs:domain rdf:resource="http://purl.org/lahouaziamine/ontMed/MedecinGeneraliste"/>
        <rdfs:range rdf:resource="http://purl.org/lahouaziamine/ontMed/MedecinSpecialiste"/>
        <rdfs:comment xml:lang="fr">Le patient est dirigé vers le spécialiste.</rdfs:comment>
        <rdfs:label xml:lang="fr">oriente vers</rdfs:label>
        <skos:altLabel xml:lang="fr">Adresse à</skos:altLabel>
        <skos:altLabel xml:lang="fr">Réfère à</skos:altLabel>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/lahouaziamine/ontMed/recoitOrientationDe -->

    <owl:ObjectProperty rdf:about="http://purl.org/lahouaziamine/ontMed/recoitOrientationDe">
        <rdfs:domain rdf:resource="http://purl.org/lahouaziamine/ontMed/MedecinSpecialiste"/>
        <rdfs:range rdf:resource="http://purl.org/lahouaziamine/ontMed/MedecinGeneraliste"/>
        <rdfs:label xml:lang="fr">reçoit l&apos;orientation de</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/lahouaziamine/ontMed/suit -->

    <owl:ObjectProperty rdf:about="http://purl.org/lahouaziamine/ontMed/suit">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://purl.org/lahouaziamine/ontMed/MedecinGeneraliste"/>
        <rdfs:range rdf:resource="http://purl.org/lahouaziamine/ontMed/Patient"/>
        <rdfs:comment xml:lang="fr">Le médecin assure le suivi global du patient.</rdfs:comment>
        <rdfs:label xml:lang="fr">suit</rdfs:label>
        <skos:altLabel xml:lang="fr">Assure le suivi de</skos:altLabel>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/lahouaziamine/ontMed/age -->

    <owl:DatatypeProperty rdf:about="http://purl.org/lahouaziamine/ontMed/age">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://purl.org/lahouaziamine/ontMed/Patient"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                <owl:withRestrictions rdf:parseType="Collection">
                    <rdf:Description>
                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</xsd:minInclusive>
                    </rdf:Description>
                    <rdf:Description>
                        <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">120</xsd:maxInclusive>
                    </rdf:Description>
                </owl:withRestrictions>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="fr">Durée écoulée depuis la naissance, exprimée en années, mois ou jours.</rdfs:comment>
        <rdfs:label xml:lang="fr">âge</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/lahouaziamine/ontMed/poids -->

    <owl:DatatypeProperty rdf:about="http://purl.org/lahouaziamine/ontMed/poids">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://purl.org/lahouaziamine/ontMed/Patient"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                <owl:withRestrictions rdf:parseType="Collection">
                    <rdf:Description>
                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.5</xsd:minInclusive>
                    </rdf:Description>
                    <rdf:Description>
                        <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">300</xsd:maxInclusive>
                    </rdf:Description>
                </owl:withRestrictions>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="fr">Masse du patient en kilogrammes.</rdfs:comment>
        <rdfs:label xml:lang="fr">poids</rdfs:label>
        <skos:altLabel xml:lang="fr">Masse corporelle</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/lahouaziamine/ontMed/sexe -->

    <owl:DatatypeProperty rdf:about="http://purl.org/lahouaziamine/ontMed/sexe">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://purl.org/lahouaziamine/ontMed/Patient"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>féminin</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>masculin</rdf:first>
                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:comment xml:lang="fr">Caractéristique biologique du patient (masculin, féminin).</rdfs:comment>
        <rdfs:label xml:lang="fr">sexe</rdfs:label>
        <skos:altLabel xml:lang="fr">Sexe biologique</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/lahouaziamine/ontMed/specialiteMedicale -->

    <owl:DatatypeProperty rdf:about="http://purl.org/lahouaziamine/ontMed/specialiteMedicale">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://purl.org/lahouaziamine/ontMed/MedecinSpecialiste"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="fr">Discipline dans laquelle le médecin exerce.</rdfs:comment>
        <rdfs:label xml:lang="fr">spécialité médicale</rdfs:label>
        <skos:altLabel xml:lang="fr">Discipline</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/lahouaziamine/ontMed/MedecinGeneraliste -->

    <owl:Class rdf:about="http://purl.org/lahouaziamine/ontMed/MedecinGeneraliste">
        <rdfs:subClassOf rdf:resource="http://purl.org/lahouaziamine/ontMed/ProfessionnelDeSante"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/lahouaziamine/ontMed/orienteVers"/>
                <owl:allValuesFrom rdf:resource="http://purl.org/lahouaziamine/ontMed/MedecinSpecialiste"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/lahouaziamine/ontMed/suit"/>
                <owl:allValuesFrom rdf:resource="http://purl.org/lahouaziamine/ontMed/Patient"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://purl.org/lahouaziamine/ontMed/MedecinSpecialiste"/>
        <rdfs:comment xml:lang="fr">Professionnel de santé de premier recours qui assure le suivi global du patient, la prévention et la coordination des soins.</rdfs:comment>
        <rdfs:label xml:lang="fr">Médecin généraliste</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/General_practitioner"/>
        <skos:altLabel xml:lang="fr">MG</skos:altLabel>
        <skos:altLabel xml:lang="fr">Médecin traitant</skos:altLabel>
        <skos:altLabel xml:lang="fr">Omnipraticien</skos:altLabel>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q39631"/>
    </owl:Class>
    


    <!-- http://purl.org/lahouaziamine/ontMed/MedecinSpecialiste -->

    <owl:Class rdf:about="http://purl.org/lahouaziamine/ontMed/MedecinSpecialiste">
        <rdfs:subClassOf rdf:resource="http://purl.org/lahouaziamine/ontMed/ProfessionnelDeSante"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/lahouaziamine/ontMed/specialiteMedicale"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="fr">Médecin exerçant dans une discipline précise, vers lequel le généraliste peut orienter le patient.</rdfs:comment>
        <rdfs:label xml:lang="fr">Médecin spécialiste</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Medical_specialty"/>
        <skos:altLabel xml:lang="fr">Spécialiste</skos:altLabel>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q2289467"/>
    </owl:Class>
    


    <!-- http://purl.org/lahouaziamine/ontMed/Pathologie -->

    <owl:Class rdf:about="http://purl.org/lahouaziamine/ontMed/Pathologie">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <owl:disjointWith rdf:resource="http://purl.org/lahouaziamine/ontMed/Personne"/>
        <rdfs:comment xml:lang="fr">Altération de l&apos;état de santé caractérisée par un ensemble de symptômes et de signes et relevant d&apos;une cause identifiable ou présumée.</rdfs:comment>
        <rdfs:label xml:lang="fr">Pathologie</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Disease"/>
        <skos:altLabel xml:lang="fr">Affection</skos:altLabel>
        <skos:altLabel xml:lang="fr">Maladie</skos:altLabel>
        <skos:altLabel xml:lang="fr">Trouble</skos:altLabel>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q12136"/>
    </owl:Class>
    


    <!-- http://purl.org/lahouaziamine/ontMed/PathologieAigue -->

    <owl:Class rdf:about="http://purl.org/lahouaziamine/ontMed/PathologieAigue">
        <rdfs:subClassOf rdf:resource="http://purl.org/lahouaziamine/ontMed/Pathologie"/>
        <owl:disjointWith rdf:resource="http://purl.org/lahouaziamine/ontMed/PathologieChronique"/>
        <rdfs:comment xml:lang="fr">Pathologie d&apos;apparition brutale et d&apos;évolution de courte durée.</rdfs:comment>
        <rdfs:label xml:lang="fr">Pathologie aiguë</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Acute_(medicine)"/>
        <skos:altLabel xml:lang="fr">Maladie aiguë</skos:altLabel>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q1262331"/>
    </owl:Class>
    


    <!-- http://purl.org/lahouaziamine/ontMed/PathologieChronique -->

    <owl:Class rdf:about="http://purl.org/lahouaziamine/ontMed/PathologieChronique">
        <rdfs:subClassOf rdf:resource="http://purl.org/lahouaziamine/ontMed/Pathologie"/>
        <rdfs:comment xml:lang="fr">Pathologie d&apos;évolution prolongée, nécessitant un suivi au long cours.</rdfs:comment>
        <rdfs:label xml:lang="fr">Pathologie chronique</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Chronic_condition"/>
        <skos:altLabel xml:lang="fr">Maladie chronique</skos:altLabel>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q13583594"/>
    </owl:Class>
    


    <!-- http://purl.org/lahouaziamine/ontMed/Patient -->

    <owl:Class rdf:about="http://purl.org/lahouaziamine/ontMed/Patient">
        <rdfs:subClassOf rdf:resource="http://purl.org/lahouaziamine/ontMed/Personne"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/lahouaziamine/ontMed/consulte"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/lahouaziamine/ontMed/MedecinGeneraliste"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/lahouaziamine/ontMed/estSuiviPar"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="http://purl.org/lahouaziamine/ontMed/MedecinGeneraliste"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/lahouaziamine/ontMed/age"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange>
                    <rdfs:Datatype>
                        <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                        <owl:withRestrictions rdf:parseType="Collection">
                            <rdf:Description>
                                <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</xsd:minInclusive>
                            </rdf:Description>
                            <rdf:Description>
                                <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">120</xsd:maxInclusive>
                            </rdf:Description>
                        </owl:withRestrictions>
                    </rdfs:Datatype>
                </owl:onDataRange>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/lahouaziamine/ontMed/sexe"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange>
                    <rdfs:Datatype>
                        <owl:oneOf>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>féminin</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first>masculin</rdf:first>
                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </owl:oneOf>
                    </rdfs:Datatype>
                </owl:onDataRange>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="fr">Personne qui consulte un professionnel de santé pour un motif de santé.</rdfs:comment>
        <rdfs:label xml:lang="fr">Patient</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Patient"/>
        <skos:altLabel xml:lang="fr">Consultant</skos:altLabel>
        <skos:altLabel xml:lang="fr">Malade</skos:altLabel>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q181600"/>
    </owl:Class>
    


    <!-- http://purl.org/lahouaziamine/ontMed/Personne -->

    <owl:Class rdf:about="http://purl.org/lahouaziamine/ontMed/Personne">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment xml:lang="fr">Être humain impliqué dans une situation de soins, quel que soit son rôle.</rdfs:comment>
        <rdfs:label xml:lang="fr">Personne</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Person"/>
        <skos:altLabel xml:lang="fr">Individu</skos:altLabel>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q5"/>
    </owl:Class>
    


    <!-- http://purl.org/lahouaziamine/ontMed/ProfessionnelDeSante -->

    <owl:Class rdf:about="http://purl.org/lahouaziamine/ontMed/ProfessionnelDeSante">
        <rdfs:subClassOf rdf:resource="http://purl.org/lahouaziamine/ontMed/Personne"/>
        <rdfs:comment xml:lang="fr">Personne exerçant une profession de santé.</rdfs:comment>
        <rdfs:label xml:lang="fr">Professionnel de santé</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Health_professional"/>
        <skos:altLabel xml:lang="fr">Soignant</skos:altLabel>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q66624419"/>
    </owl:Class>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
